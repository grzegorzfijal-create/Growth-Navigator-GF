# Połączenie aplikacji z bazą. Domyślne dane zgadzają się z docker-compose.yml.
DATABASE_URL="postgresql://gym:gym@127.0.0.1:5432/gymtracker?schema=public"

# Połączenie bezpośrednie (bez puli) - używane wyłącznie przez migracje Prismy.
